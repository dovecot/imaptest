messages: all

# RFC 3501 / RFC 9051 FETCH BODY, BODYSTRUCTURE and BODY[section] for
# single-part messages.
#
# BODYSTRUCTURE extension data is optional, so it's matched after "$?".
# Parameters of a part without Content-Type depend on the server's defaults,
# so they're matched with "$".

#
# 1) Non-MIME message
#
ok fetch 1 (body bodystructure)
* 1 fetch (body ("TEXT" "PLAIN" $ NIL NIL "7BIT" 71 3) bodystructure ("TEXT" "PLAIN" $ NIL NIL "7BIT" 71 3 $? NIL NIL NIL NIL))

ok fetch 1 body.peek[header]
* 1 fetch (body[header] {{{
Date: Mon, 7 Feb 1994 21:52:25 -0800
From: Fred Foobar <foobar@example.com>
Subject: non-MIME message
To: mooch@example.org


}}})

ok fetch 1 body.peek[text]
* 1 fetch (body[text] {{{
Hello Joe, do you think we can meet at 3:30 tomorrow?
Second line.


}}})

# A non-multipart message has only part 1, which is the message body
ok fetch 1 body.peek[1]
* 1 fetch (body[1] {{{
Hello Joe, do you think we can meet at 3:30 tomorrow?
Second line.


}}})

ok fetch 1 body.peek[]
* 1 fetch (body[] {{{
Date: Mon, 7 Feb 1994 21:52:25 -0800
From: Fred Foobar <foobar@example.com>
Subject: non-MIME message
To: mooch@example.org

Hello Joe, do you think we can meet at 3:30 tomorrow?
Second line.


}}})

# HEADER.FIELDS matches the field names case-insensitively and includes the
# blank line that ends the header.
ok fetch 1 body.peek[header.fields (FROM subject)]
* 1 fetch (body[header.fields (FROM subject)] {{{
From: Fred Foobar <foobar@example.com>
Subject: non-MIME message


}}})

ok fetch 1 body.peek[header.fields.not (date from subject)]
* 1 fetch (body[header.fields.not (date from subject)] {{{
To: mooch@example.org


}}})

ok fetch 1 body.peek[header.fields (x-nonexistent)]
* 1 fetch (body[header.fields (x-nonexistent)] {{{


}}})

# Partial fetches. A substring of HEADER.FIELDS is taken after subsetting.
ok fetch 1 body.peek[header.fields (subject)]<9.7>
* 1 fetch (body[header.fields (subject)]<9> "non-MIM")
ok fetch 1 body.peek[1]<11.15>
* 1 fetch (body[1]<11> "do you think we")
ok fetch 1 body.peek[text]<1000.10>
* 1 fetch (body[text]<1000> "")
ok fetch 1 body.peek[]<185.100>
* 1 fetch (body[]<185> {{{
Second line.


}}})
# A partial fetch that starts at octet 0 is returned as a partial fetch, even
# if it was truncated.
ok fetch 1 body.peek[]<0.10000>
* 1 fetch (body[]<0> {{{
Date: Mon, 7 Feb 1994 21:52:25 -0800
From: Fred Foobar <foobar@example.com>
Subject: non-MIME message
To: mooch@example.org

Hello Joe, do you think we can meet at 3:30 tomorrow?
Second line.


}}})

ok fetch 1 rfc822.size
* 1 fetch (rfc822.size 201)

#
# 2) text/plain with all of the MIME header fields
#
ok fetch 2 body
* 2 fetch (body ("TEXT" "PLAIN" ($!unordered=2 $!noextra "CHARSET" "iso-8859-1" "FORMAT" "flowed") "<part1@example.com>" "Some description" "QUOTED-PRINTABLE" 91 3))
# The language can be returned either as a string or as a list.
ok fetch 2 bodystructure
* 2 fetch (bodystructure ("TEXT" "PLAIN" ($!unordered=2 $!noextra "CHARSET" "iso-8859-1" "FORMAT" "flowed") "<part1@example.com>" "Some description" "QUOTED-PRINTABLE" 91 3 $? "Q2hlY2sgSW50ZWdyaXR5IQ==" ("INLINE" NIL) $ "http://example.com/doc.txt"))

# BODY[] returns the content in its transfer encoding
ok fetch 2 body.peek[1]
* 2 fetch (body[1] {{{
Caf=E9 au lait, a long line that has been soft-wrapped in quoted-printa=
ble encoding.


}}})

#
# 3) text/html in base64
#
ok fetch 3 (body bodystructure)
* 3 fetch (body ("TEXT" "HTML" ("CHARSET" "utf-8") NIL NIL "BASE64" 68 2) bodystructure ("TEXT" "HTML" ("CHARSET" "utf-8") NIL NIL "BASE64" 68 2 $? NIL NIL NIL NIL))
ok fetch 3 body.peek[1]
* 3 fetch (body[1] {{{
PGh0bWw+PGJvZHk+PHA+SGVsbG8gd29ybGQ8L3A+PC9ib2R5PjwvaHRtbD4NCg==


}}})

#
# 4) application/octet-stream: no line count for non-text parts
#
ok fetch 4 (body bodystructure)
* 4 fetch (body ("APPLICATION" "OCTET-STREAM" ("NAME" "data.bin") NIL NIL "BASE64" 356) bodystructure ("APPLICATION" "OCTET-STREAM" ("NAME" "data.bin") NIL NIL "BASE64" 356 $? NIL ("ATTACHMENT" ("FILENAME" "data.bin")) NIL NIL))
ok fetch 4 body.peek[1]<0.20>
* 4 fetch (body[1]<0> "AAECAwQFBgcICQoLDA0O")

#
# 5) Upper case Content-Type and Content-Transfer-Encoding values
#
ok fetch 5 (body bodystructure)
* 5 fetch (body ("TEXT" "PLAIN" ("CHARSET" "US-ASCII") NIL NIL "7BIT" 28 2) bodystructure ("TEXT" "PLAIN" ("CHARSET" "US-ASCII") NIL NIL "7BIT" 28 2 $? NIL NIL NIL NIL))

#
# 6) Unknown Content-Transfer-Encoding is returned as a string
#
ok fetch 6 (body bodystructure)
* 6 fetch (body ("APPLICATION" "X-FOO" NIL NIL NIL "X-CUSTOM" 21) bodystructure ("APPLICATION" "X-FOO" NIL NIL NIL "X-CUSTOM" 21 $? NIL NIL NIL NIL))
ok fetch 6 body.peek[1]
* 6 fetch (body[1] {{{
Unknown encoding.


}}})

#
# 7) Message with a header, but no body and no blank line after the header
#
ok fetch 7 (body bodystructure rfc822.size)
* 7 fetch (body ("TEXT" "PLAIN" $ NIL NIL "7BIT" 0 0) bodystructure ("TEXT" "PLAIN" $ NIL NIL "7BIT" 0 0 $? NIL NIL NIL NIL) rfc822.size 96)
# The blank line is included in header fetches, except when the message has
# no body and no blank line.
ok fetch 7 body.peek[header]
* 7 fetch (body[header] {{{
Date: Mon, 7 Feb 1994 21:52:25 -0800
From: Fred Foobar <foobar@example.com>
Subject: no body

}}})
ok fetch 7 body.peek[text]
* 7 fetch (body[text] "")
ok fetch 7 body.peek[1]
* 7 fetch (body[1] "")
ok fetch 7 body.peek[header.fields (subject)]
* 7 fetch (body[header.fields (subject)] {{{
Subject: no body

}}})
