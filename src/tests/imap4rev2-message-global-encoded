capabilities: IMAP4rev1 IMAP4rev2
connections: 2
state: appended
messages: all

# RFC 6532 3.5 allows a Content-Transfer-Encoding for message/global. In
# IMAP4rev2 (RFC 9051) a MESSAGE/GLOBAL part can't be returned as a basic
# body part (body-type-basic ABNF), so it has the envelope and the body
# structure of the encapsulated (decoded) message. The body size is the
# encoded size. RFC 9051 doesn't specify whether the line count is of the
# encoded or the decoded message, or whether the HEADER/TEXT/n sections
# of an encoded message/global are decoded, so those aren't tested.
#
# In IMAP4rev1 (RFC 3501) message/global is a basic body part.
#
# Connection 1 is IMAP4rev1, connection 2 has IMAP4rev2 enabled. A server
# advertising only IMAP4rev2 responds using IMAP4rev2 rules from the start
# (RFC 9051 7.2.2), so IMAP4rev1 must be advertised as well.

2 ok enable IMAP4rev2
1 ok select $mailbox
2 ok select $mailbox

#
# 1) base64-encoded message/global
#
1 ok fetch 1 body
* 1 fetch (body (("TEXT" "PLAIN" ("CHARSET" "us-ascii") NIL NIL "7BIT" 12 1)("MESSAGE" "GLOBAL" NIL NIL NIL "BASE64" 210) "MIXED"))
1 ok fetch 1 bodystructure
* 1 fetch (bodystructure (("TEXT" "PLAIN" ("CHARSET" "us-ascii") NIL NIL "7BIT" 12 1 $? NIL NIL NIL NIL)("MESSAGE" "GLOBAL" NIL NIL NIL "BASE64" 210 $? NIL NIL NIL NIL) "MIXED" $? ("BOUNDARY" "g1") NIL NIL NIL))

2 ok fetch 1 body
* 1 fetch (body (("TEXT" "PLAIN" ("CHARSET" "us-ascii") NIL NIL "7BIT" 12 1)("MESSAGE" "GLOBAL" NIL NIL NIL "BASE64" 210 ("Sun, 6 Feb 1994 10:00:00 +0100" "Bücher" (("Jürgen Müller" NIL "jürgen" "example.de")) (("Jürgen Müller" NIL "jürgen" "example.de")) (("Jürgen Müller" NIL "jürgen" "example.de")) NIL NIL NIL NIL "<global-enc@example.de>") ("TEXT" "PLAIN" $ NIL NIL "7BIT" 13 1) $) "MIXED"))
2 ok fetch 1 bodystructure
* 1 fetch (bodystructure (("TEXT" "PLAIN" ("CHARSET" "us-ascii") NIL NIL "7BIT" 12 1 $? NIL NIL NIL NIL)("MESSAGE" "GLOBAL" NIL NIL NIL "BASE64" 210 ("Sun, 6 Feb 1994 10:00:00 +0100" "Bücher" (("Jürgen Müller" NIL "jürgen" "example.de")) (("Jürgen Müller" NIL "jürgen" "example.de")) (("Jürgen Müller" NIL "jürgen" "example.de")) NIL NIL NIL NIL "<global-enc@example.de>") ("TEXT" "PLAIN" $ NIL NIL "7BIT" 13 1 $? NIL NIL NIL NIL) $ $? NIL NIL NIL NIL) "MIXED" $? ("BOUNDARY" "g1") NIL NIL NIL))

