capabilities: UIDBATCHES
messages: 6

# RFC 10022: The UID ranges are returned in descending order as
# highest:lowest UID, and batch 1 has the highest UIDs. Clients must not
# request batch sizes smaller than 500.

ok fetch 1 uid
* 1 fetch (uid $uid1)
ok fetch 6 uid
* 6 fetch (uid $uid6)

# All 6 messages fit in one batch
ok uidbatches 1000
* uidbatches (tag $tag) $uid6:$uid1

# Batch range selects batch numbers. Only the existing batches are returned.
ok uidbatches 1000 1:2
* uidbatches (tag $tag) $uid6:$uid1

# Batch range with no existing batches returns an empty response
ok uidbatches 500 100:100
* uidbatches (tag $tag)
! uidbatches (tag $tag) $

# Reversed batch range is BAD [CLIENTBUG]
uidbatches 1000 4:1
bad [clientbug]

# Batch size below the server's minimum (at least 500) is NO [TOOFEW]
uidbatches 499
no [toofew]
