capabilities: IMAP4rev2
state: auth

# RFC 9051 6.3.1: A server advertising both IMAP4rev1 and IMAP4rev2 enables
# IMAP4rev2 with ENABLE. Unknown extensions are ignored, and the ENABLED
# response is sent even if nothing was enabled.

bad enable

ok enable x-imaptest-unknown-extension
* enabled

ok enable IMAP4rev2
* enabled IMAP4rev2
